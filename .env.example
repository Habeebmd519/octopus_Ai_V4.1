APP_NAME=KeralaTour AI Backend V4
PORT=5000
ENV=development

# Firestore — inject this secret through your deployment platform; never commit it.
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# FIREBASE_SERVICE_ACCOUNT=/secure/mounted/service-account.json
FIRESTORE_COLLECTION=places

# Optional live web search
TAVILY_API_KEY=

# Optional exact Google Maps distance matrix
GOOGLE_MAPS_API_KEY=

# Optional weather provider compatible with WeatherAPI-style responses.
WEATHER_API_URL=
WEATHER_API_KEY=

# Comma-separated browser origins. Add your HTTPS production domain before deploying.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
LOCATION_CACHE_TTL_SECONDS=300

# Legacy fallback only. V4 Puter mode does not need Groq.
ENABLE_GROQ=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# V4 Puter agent
PUTER_AGENT_ENABLED=true
PUTER_AGENT_MODEL=openai/gpt-5.6-luna
PUTER_AGENT_MAX_TOOL_ROUNDS=4
PUTER_AGENT_CONTEXT_LIMIT=10
V4_SEARCH_CANDIDATE_LIMIT=900
V4_AUX_CACHE_TTL=45

CACHE_TTL_SECONDS=21600
LOCAL_CACHE_FILE=places_cache.json
REQUEST_TIMEOUT_SECONDS=12
MAX_PLACES_CONTEXT=10
MAX_MATCHED_PLACES_RESPONSE=8
DEFAULT_CARD_LIMIT=7
EXPLAIN_CARD_LIMIT=1
ENABLE_DEBUG_LOGS=true
